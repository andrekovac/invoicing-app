root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 2
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

# the desktop program exports with windows line endings and a BOM, keep them as they are
[api/seed/legacy/*.csv]
end_of_line = crlf
charset = utf-8-bom
insert_final_newline = false
