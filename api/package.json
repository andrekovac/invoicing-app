{
  "name": "invoicing-api",
  "version": "0.1.0",
  "private": true,
  "main": "server.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning server.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch server.js",
    "db:reset": "node --disable-warning=ExperimentalWarning scripts/reset-db.js",
    "seed": "node --disable-warning=ExperimentalWarning seed/seed.js",
    "import": "node --disable-warning=ExperimentalWarning scripts/import-legacy.js",
    "outbox": "node --disable-warning=ExperimentalWarning scripts/send-outbox.js",
    "check:numbers": "node --disable-warning=ExperimentalWarning scripts/check-numbers.js",
    "recurring": "node --disable-warning=ExperimentalWarning scripts/run-recurring.js",
    "export:month": "node --disable-warning=ExperimentalWarning scripts/export-month.js",
    "test": "node --disable-warning=ExperimentalWarning --test",
    "lint": "node --disable-warning=ExperimentalWarning scripts/lint.js"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "express": "4.22.3"
  },
